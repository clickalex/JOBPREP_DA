{
  // One-click environment on GitHub Codespaces (or VS Code "Reopen in Container").
  // Everything is preinstalled: run `python progress.py` or open the notebook straight away.
  "name": "JOBPREP_DA · Data Analyst prep",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "postCreateCommand": "pip install --user -r requirements.txt -r website/requirements.txt && pip install --user pytest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "qwtel.sqlite-viewer",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-sqlite"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.associations": { "*.sql": "sql" }
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "practice/sql/EXERCISES.md"]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Docs site (mkdocs serve)" } }
}
